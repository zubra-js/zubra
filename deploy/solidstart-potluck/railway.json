{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/solidstart-potluck/Dockerfile",
    "watchPatterns": [
      "/Cargo.toml",
      "/Cargo.lock",
      "/src/**",
      "/wasm/**",
      "/macros/**",
      "/sync-server/**",
      "/compiler/**",
      "/registry/**",
      "/runtime/**",
      "/server/**",
      "/plugin/**",
      "/examples/meta/solidstart-potluck/**",
      "/deploy/solidstart-potluck/**",
      "/.dockerignore"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "sleepApplication": true,
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
