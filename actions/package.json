{
  "name": "@zubra/actions",
  "version": "6.0.6",
  "description": "Serve Zubra components' 'use server' functions over plain form posts, enhanced to fetch when JavaScript loads.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": {
      "types": "./src/client.d.ts",
      "default": "./src/client.js"
    },
    "./enhance-forms": {
      "types": "./src/enhance-forms.d.ts",
      "default": "./src/enhance-forms.js"
    },
    "./edge": {
      "types": "./src/edge.d.ts",
      "default": "./src/edge.js"
    },
    "./build": {
      "types": "./src/build.d.ts",
      "default": "./src/build.js"
    },
    "./express": "./src/express.js",
    "./fastify": "./src/fastify.js",
    "./hono": "./src/hono.js"
  },
  "scripts": {
    "build": "node scripts/build-production.js",
    "test": "node --test \"test/*.test.js\""
  },
  "peerDependencies": {
    "@zubra/compiler": "^6.0.0",
    "@zubra/server": "^6.0.0"
  },
  "devDependencies": {
    "@zubra/compiler": "file:../compiler",
    "@zubra/runtime": "file:../runtime",
    "@zubra/server": "file:../server",
    "esbuild": "0.28.2",
    "express": "5.3.0",
    "fastify": "5.12.8",
    "hono": "4.13.17",
    "playwright": "1.63.0"
  },
  "bin": {
    "zubra-actions": "bin/zubra-actions.js"
  },
  "files": [
    "src",
    "dist",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zubra-js/zubra.git",
    "directory": "actions"
  },
  "homepage": "https://github.com/zubra-js/zubra/tree/main/actions#readme",
  "bugs": {
    "url": "https://github.com/zubra-js/zubra/issues"
  },
  "keywords": [
    "zubra",
    "web components",
    "custom elements",
    "server actions",
    "forms",
    "use server"
  ]
}
