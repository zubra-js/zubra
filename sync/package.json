{
  "name": "@zubra/sync",
  "version": "6.0.3",
  "description": "Local-first state for Zubra components: 'use collection' keeps a component's state in IndexedDB, across reloads, offline, and in step across tabs.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./connect": {
      "types": "./src/connect.d.ts",
      "default": "./src/connect.js"
    },
    "./follow": {
      "types": "./src/follow.d.ts",
      "default": "./src/follow.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    },
    "./sqlite": {
      "types": "./src/sqlite.d.ts",
      "default": "./src/sqlite.js"
    },
    "./durable": {
      "types": "./src/durable.d.ts",
      "default": "./src/durable.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-production.js",
    "test": "node --test \"test/*.test.js\"",
    "test:binary": "node --import ./test/binary.js --test test/browser.test.js"
  },
  "peerDependencies": {
    "@zubra/runtime": "^6.0.0"
  },
  "devDependencies": {
    "@zubra/compiler": "file:../compiler",
    "@zubra/runtime": "file:../runtime",
    "@zubra/server": "file:../server",
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zubra-js/zubra.git",
    "directory": "sync"
  },
  "homepage": "https://github.com/zubra-js/zubra/tree/main/sync#readme",
  "bugs": {
    "url": "https://github.com/zubra-js/zubra/issues"
  },
  "keywords": [
    "zubra",
    "web components",
    "custom elements",
    "local-first",
    "offline",
    "indexeddb",
    "sync"
  ]
}
