{
  "name": "@zubra/compiler",
  "version": "6.0.4",
  "description": "The Zubra compiler as WebAssembly: compile .zb components from Node without installing Rust",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zubra-js/zubra.git",
    "directory": "compiler"
  },
  "homepage": "https://github.com/zubra-js/zubra/tree/main/compiler#readme",
  "bugs": {
    "url": "https://github.com/zubra-js/zubra/issues"
  },
  "keywords": [
    "zubra",
    "web components",
    "custom elements",
    "compiler",
    "webassembly",
    "ssr",
    "cli"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./wasm": {
      "types": "./core.d.ts",
      "default": "./core.js"
    },
    "./zubra.wasm": "./zubra.wasm",
    "./library": {
      "types": "./library.d.ts",
      "default": "./library.js"
    },
    "./embed": {
      "types": "./embed.d.ts",
      "default": "./embed.js"
    },
    "./mcp": {
      "types": "./mcp.d.ts",
      "default": "./mcp.js"
    },
    "./typecheck": {
      "types": "./typecheck.d.ts",
      "default": "./typecheck.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "core.js",
    "core.d.ts",
    "zubra.wasm",
    "cli.js",
    "library.js",
    "library.d.ts",
    "embed.js",
    "embed.d.ts",
    "mcp.js",
    "mcp.d.ts",
    "typecheck.js",
    "typecheck.d.ts",
    "solid.js",
    "registry",
    "!registry/test"
  ],
  "scripts": {
    "build": "cargo build --locked -p zubra-wasm --target wasm32-unknown-unknown --release && cp ../target/wasm32-unknown-unknown/release/zubra_wasm.wasm zubra.wasm",
    "test": "node --test \"test/*.test.js\"",
    "prepack": "node scripts/prepack.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "zubra": "cli.js"
  },
  "peerDependencies": {
    "@zubra/runtime": ">=6.0.4"
  },
  "peerDependenciesMeta": {
    "@zubra/runtime": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solidjs/web": "2.0.0-rc.22",
    "liquidjs": "10.30.1",
    "solid-js": "2.0.0-rc.22",
    "typescript": "7.0.2"
  }
}
